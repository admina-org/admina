[build-system]
requires = ["setuptools>=68.0"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ plugin_name }}"
version = "0.1.0"
description = "Admina {{ plugin_type.replace('_', ' ') }} plugin: {{ plugin_name }}"
requires-python = ">=3.11"
dependencies = [
    # Floor pinned to the admina-framework version that generated this
    # scaffold: the plugin contract (class-attr name, async ABC methods)
    # requires at least that runtime.
    "admina-framework>={{ admina_version }}",
]

[project.entry-points."admina.plugins"]
{{ plugin_name }} = "{{ plugin_name.replace('-', '_') }}"

[project.optional-dependencies]
dev = ["pytest>=8.0"]
