# Admina — Environment Configuration
#
# Secrets are auto-generated on first launch by 'admina dev' or 'admina init'.
# They are stored encrypted in .admina/secrets.json and written to .env.
#
# To manage credentials:
#   admina password show    — display current credentials
#   admina password reset   — regenerate all credentials
#   admina password set     — set a custom password
#
# If you prefer manual setup, fill in the values below and run:
#   docker compose up --build

# ── Auth ────────────────────────────────────────────────────
# Auto-generated by vault. Or generate manually: openssl rand -hex 32
ADMINA_API_KEY=

# Dashboard password (shared across dashboard, Grafana, ClickHouse)
ADMINA_DASHBOARD_PASSWORD=

# ── ClickHouse ───────────────────────────────────────────────
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DB=admina

# ── Forensic Black Box storage ──────────────────────────────
# Backend: memory (default) | filesystem | s3
# FORENSIC_BACKEND=filesystem
# FORENSIC_BASE_DIR=/var/lib/admina/forensic
# For an S3-compatible backend (AWS S3, MinIO, R2, SeaweedFS, …):
# FORENSIC_BACKEND=s3
# FORENSIC_S3_ENDPOINT=http://minio:9000   # omit for AWS S3
# FORENSIC_S3_BUCKET=forensic-blackbox
# FORENSIC_S3_ACCESS_KEY=
# FORENSIC_S3_SECRET_KEY=

# ── Redis ────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379/0

# ── OpenTelemetry ────────────────────────────────────────────
# OTEL_ENDPOINT=http://otel-collector:4317

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=

# ── Proxy settings ───────────────────────────────────────────
# UPSTREAM_MCP_URL=http://your-mcp-server:9000
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com
# MAX_REQUEST_TOKENS=100000
# ROUTING_CONFIG_PATH=/etc/admina/routing.yaml

# ── Rate Limiting ────────────────────────────────────────────
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_IP_MULTIPLIER=5

# ── Governance domains ───────────────────────────────────────
# INJECTION_FAST_PATH_ENABLED=true
# INJECTION_DEEP_PATH_ENABLED=true
# LOOP_WINDOW_SIZE=10
# LOOP_SIMILARITY_THRESHOLD=0.85
# LOOP_MAX_CONSECUTIVE=3
# PII_REDACTION_ENABLED=true

# Governance mode: enforce (default) | observe | dry-run
# NOTE: this one is read under its ADMINA_-prefixed name; the bare
# GOVERNANCE_MODE is not accepted (unlike the LOOP_/INJECTION_ vars above).
# ADMINA_GOVERNANCE_MODE=enforce

# What happens when a pluggable governance guard raises:
# open (default) skips it and records an ERROR check; closed turns it into a BLOCK.
# ADMINA_GUARD_FAIL_MODE=open

# PII detection engine: spacy-regex (default) | presidio
# presidio requires: pip install "admina-framework[presidio]"
# ADMINA_PII_ENGINE=spacy-regex

# Governance engine backend: auto (default) | python | rust
# ADMINA_ENGINE=auto

# ── OpenAI-compatible gateway ────────────────────────────────
# Upstream the /v1 gateway forwards to; must include the API base path.
# ADMINA_GATEWAY_UPSTREAM=http://localhost:11434/v1
# ADMINA_GATEWAY_BLOCK_MESSAGE=This request was blocked by the Admina governance policy.
# Comma-separated model ids to expose on GET /v1/models (empty = all).
# ADMINA_GATEWAY_MODELS_ALLOWLIST=

# ── Forensic chain-state signing ─────────────────────────────
# HMAC-SHA256 key for _chain_state.json. Unsigned state still falls back to
# reconstruction from the immutable records, but signing is recommended.
# ADMINA_FORENSIC_STATE_KEY=

# Set to true ONLY for local development without auth
# ALLOW_UNAUTHENTICATED=false

# Set to true behind HTTPS so the dashboard session cookie is only sent
# over TLS (recommended for any production deployment).
# DASHBOARD_COOKIE_SECURE=false
