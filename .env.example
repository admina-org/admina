# Admina — Environment Configuration
#
# Secrets are auto-generated on first launch by 'admina dev' or 'admina init'.
# They are stored encrypted in .admina/secrets.json and written to .env.
#
# To manage credentials:
#   admina password show    — display current credentials
#   admina password reset   — regenerate all credentials
#   admina password set     — set a custom password
#
# If you prefer manual setup, fill in the values below and run:
#   docker compose up --build

# ── Auth ────────────────────────────────────────────────────
# Auto-generated by vault. Or generate manually: openssl rand -hex 32
ADMINA_API_KEY=

# Dashboard password (shared across dashboard, Grafana, ClickHouse)
ADMINA_DASHBOARD_PASSWORD=

# ── ClickHouse ───────────────────────────────────────────────
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DB=admina

# ── Forensic Black Box storage ──────────────────────────────
# Backend: memory (default) | filesystem | s3
# FORENSIC_BACKEND=filesystem
# FORENSIC_BASE_DIR=/var/lib/admina/forensic
# For an S3-compatible backend (AWS S3, MinIO, R2, SeaweedFS, …):
# FORENSIC_BACKEND=s3
# FORENSIC_S3_ENDPOINT=http://minio:9000   # omit for AWS S3
# FORENSIC_S3_BUCKET=forensic-blackbox
# FORENSIC_S3_ACCESS_KEY=
# FORENSIC_S3_SECRET_KEY=

# ── Redis ────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379/0

# ── OpenTelemetry ────────────────────────────────────────────
# OTEL_ENDPOINT=http://otel-collector:4317

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=

# ── Proxy settings ───────────────────────────────────────────
# UPSTREAM_MCP_URL=http://your-mcp-server:9000
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com
# Longest request content on /mcp, estimated as its length in characters
# (0 = no limit); longer → 413.
# MAX_REQUEST_TOKENS=100000
# Largest request body on any route, in bytes (0 = no limit); a larger body
# gets 413 before it is parsed.
# ADMINA_MAX_REQUEST_BYTES=10485760
# ROUTING_CONFIG_PATH=/etc/admina/routing.yaml

# ── Rate Limiting ────────────────────────────────────────────
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_IP_MULTIPLIER=5

# ── Governance domains ───────────────────────────────────────
# INJECTION_FAST_PATH_ENABLED=true
# INJECTION_DEEP_PATH_ENABLED=true
# LOOP_WINDOW_SIZE=10
# LOOP_SIMILARITY_THRESHOLD=0.85
# LOOP_MAX_CONSECUTIVE=3
# PII_REDACTION_ENABLED=true

# Governance mode: enforce (default) | observe | dry-run
# NOTE: this one is read under its ADMINA_-prefixed name; the bare
# GOVERNANCE_MODE is not accepted (unlike the LOOP_/INJECTION_ vars above).
# ADMINA_GOVERNANCE_MODE=enforce

# What happens when a pluggable governance guard raises:
# open (default) skips it and records an ERROR check; closed turns it into a BLOCK.
# ADMINA_GUARD_FAIL_MODE=open

# PII detection engine: spacy-regex (default) | presidio
# presidio requires: pip install "admina-framework[presidio]"
# ADMINA_PII_ENGINE=spacy-regex

# Governance engine backend: auto (default) | python | rust
# ADMINA_ENGINE=auto

# ── OpenAI-compatible gateway ────────────────────────────────
# Upstream the /v1 gateway forwards to; must include the API base path.
# ADMINA_GATEWAY_UPSTREAM=http://localhost:11434/v1
# ADMINA_GATEWAY_BLOCK_MESSAGE=This request was blocked by the Admina governance policy.
# Longest message text of a chat completion, in characters: the text of
# every message (0 = no limit); longer → 413 before any governance check.
# ADMINA_GATEWAY_MAX_PROMPT_CHARS=0
# Comma-separated model ids to expose on GET /v1/models (empty = all).
# ADMINA_GATEWAY_MODELS_ALLOWLIST=
# Named upstream routes, name=url[,name=url…] (names: lowercase letters,
# digits, _). Replaces gateway.upstreams of admina.yaml. A request picks a
# route with the X-Admina-Upstream header (unknown name → 400); without it
# the gateway uses gateway.default_upstream, else the first route. Unset:
# one route, "default", to ADMINA_GATEWAY_UPSTREAM.
# ADMINA_GATEWAY_UPSTREAMS=main=http://main.upstream.test/v1,util=http://util.upstream.test/v1
# API key sent upstream as "Authorization: Bearer <key>" (unset = no header).
# Set the key or a file holding it (read once at startup), not both.
# ADMINA_GATEWAY_UPSTREAM_API_KEY=
# ADMINA_GATEWAY_UPSTREAM_API_KEY_FILE=/run/secrets/upstream_api_key
# Key of one route, used instead of the key above: <NAME> is the route name
# in upper case.
# ADMINA_GATEWAY_UPSTREAM_UTIL_API_KEY_FILE=/run/secrets/util_api_key
# How streamed chat completions are relayed: passthrough (the upstream
# bytes, unchanged, while PII_REDACTION_ENABLED=false; otherwise as
# governed) or governed (each chunk parsed and re-serialised). Unset:
# gateway.stream_mode of admina.yaml, else passthrough.
# ADMINA_GATEWAY_STREAM_MODE=passthrough
# Upstream timeouts in seconds (0 = no limit). CONNECT: opening a
# connection or getting one from the pool; READ: each wait for upstream
# bytes; TOTAL: the whole exchange. A timeout before the response starts
# gets 504; during a stream, one SSE error event ends it.
# ADMINA_GATEWAY_TIMEOUT_CONNECT=30
# ADMINA_GATEWAY_TIMEOUT_READ=30
# ADMINA_GATEWAY_TIMEOUT_TOTAL=0
# Connection pool of the gateway's upstream client.
# ADMINA_GATEWAY_MAX_CONNECTIONS=100
# ADMINA_GATEWAY_MAX_KEEPALIVE_CONNECTIONS=20
# Message roles the gateway's firewall scans, among system, user, assistant
# and tool (empty = all four; messages with any other role are always
# scanned). A request can narrow the scan with X-Admina-Scan-Policy.
# ADMINA_GATEWAY_SCAN_ROLES=system,user,assistant,tool
# Honour X-Admina-Scan-Policy (default false: the header is ignored and every
# request is scanned in full). When true, any caller that holds the API key
# can narrow the scan of its own requests, down to leaving out every user
# message; the active ruleset it must declare is public (X-Admina-Ruleset).
# Turn it on only when every such caller is trusted to scan what it declares.
# ADMINA_GATEWAY_SCAN_POLICY_ENABLED=false
# The governance pipeline of the gateway, and the PII redaction of
# completions, run in a pool of worker threads.
# WORKERS: threads, the most requests governed at once (0 = number of CPUs).
# TIMEOUT: seconds a request waits for its governance decision, the wait for
# a thread included (0 = no limit); past it the request is blocked. A request
# whose pipeline raises is blocked too (guard contract errors: see
# ADMINA_GUARD_FAIL_MODE).
# ADMINA_GATEWAY_PIPELINE_WORKERS=0
# ADMINA_GATEWAY_PIPELINE_TIMEOUT=0
# Run the firewall on the completion text too: a non-streaming completion is
# checked before it is returned (blocked when flagged, in enforce mode); a
# stream is checked when it ends and the result is only recorded.
# ADMINA_GATEWAY_SCAN_RESPONSE=false

# ── Forensic chain-state signing ─────────────────────────────
# HMAC-SHA256 key for _chain_state.json. Unsigned state still falls back to
# reconstruction from the immutable records, but signing is recommended.
# ADMINA_FORENSIC_STATE_KEY=

# Set to true ONLY for local development without auth
# ALLOW_UNAUTHENTICATED=false

# The dashboard session cookie is marked Secure automatically on HTTPS.
# Set to true when TLS terminates at a reverse proxy that does not forward
# the original scheme.
# DASHBOARD_COOKIE_SECURE=false

# Bundled dashboard (GET /) and its browser sign-in. Set to false when the
# dashboard is not used; the /api/dashboard/* API keeps working with the key.
# ADMINA_DASHBOARD_ENABLED=true
# Dashboard browser session lifetime in seconds (60 to 43200).
# ADMINA_DASHBOARD_SESSION_TTL=3600
# Public OpenAPI docs (/docs, /redoc, /openapi.json).
# ADMINA_API_DOCS_ENABLED=true
